generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECTOR
  SECRETARIA
  DOCENTE
}
enum Nationality {
  VENEZOLANO
  EXTRANJERO
}
enum Sex {
  MASCULINO
  FEMENINO
}
enum MaritalStatus {
  SOLTERO
  CASADO
  VIUDO
  DIVORCIADO
  UNION_ESTABLE
}
enum LivingWith {
  MADRE
  PADRE
  AUTORIZADO
}
enum RelationshipType {
  MADRE
  PADRE
  AUTORIZADO
  OTRO
}
enum AccountType {
  CORRIENTE
  AHORRO
  OTRA
}
enum EducationModality {
  MEDIA_GENERAL
  MEDIA_TECNICA
}
enum StudentCondition {
  REGULAR
  MATERIA_PENDIENTE
  REPITIENTE
  RETIRADO
  RETIRADO_MODIFICADO
  GRADUADO
  INACTIVO
}
enum DocumentType {
  CEDULA
  PARTIDA_NACIMIENTO
  BOLETA_PROMOCION
  FOTO_ALUMNO
  FOTO_REPRESENTANTE
  CEDULA_REPRESENTANTE
  NOTAS_CERTIFICADAS
  CARTA_BUENA_CONDUCTA
  CUENTA_BANCARIA
  INFORME_MEDICO
  AUTORIZACION_REPRESENTANTE
  OTRO
}
enum StaffType {
  DOCENTE
  ADMINISTRATIVO
  OBRERO
  COCINERO
}
enum EmploymentCondition {
  ACTIVO
  REPOSO_CONTINUO
  INCAPACITADO
  JUBILADO
  EN_PROCESO_JUBILACION
  PROCESO_ADMINISTRATIVO
}
enum IncapacityExecutor {
  IPASME
  IVSS
}
enum HousingTenure {
  PROPIA
  ALQUILADA
  PRESTADA
}
enum QualificationType {
  PREGRADO
  ESPECIALIZACION
  MAESTRIA
  DOCTORADO
  OTRO
}
enum GradingType {
  NUMERIC
  ORIENTATION_LETTER
}
enum LapseStatus {
  PLANNED
  OPEN
  CLOSED
}
enum AssessmentForm {
  PRIMERA
  SEGUNDA
}
enum AttendanceStatus {
  PRESENTE
  INASISTENTE
}
enum ResultStatus {
  APROBADO
  REPROBADO
  PENDIENTE
}
enum PendingStatus {
  ABIERTA
  APROBADA
  AGOTADA_REVISION
  REPETIR
}
enum AttemptStatus {
  PENDIENTE
  PRESENTADA
  INASISTENTE
}
enum WithdrawalType {
  // Valores históricos conservados por compatibilidad con registros anteriores.
  PRIMEROS_30_DIAS
  RESTO_ANO
  // Regla vigente: hasta el 31/10 sale de nómina; desde el 01/11 conserva posición.
  HASTA_CIERRE_MATRICULA
  POST_CIERRE_MATRICULA
}
enum EnrollmentMovementType {
  RETIRO
  REINCORPORACION
}
enum EnrollmentSubjectOrigin {
  PLAN_ACTUAL
  MATERIA_PENDIENTE
  REPITENCIA
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  role             Role
  active           Boolean  @default(true)
  refreshTokenHash String?
  lastLoginAt      DateTime?
  staffId          String?  @unique
  staff            Staff?   @relation(fields: [staffId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  auditLogs        AuditLog[]
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}

model Institution {
  id             String @id @default(uuid())
  name           String
  plantCode      String?
  statisticalCode String?
  dependencyCode String?
  address        String
  phone          String?
  email          String?
  stateId        String?
  municipalityId String?
  parishId       String?
  directorTitle  String?
  directorName   String?
  directorNationality Nationality?
  directorIdentity String?
  directorAddress String?
  directorPhone   String?
  directorEmail   String?
  schoolLogoPath  String?
  ministryLogoPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FederalState {
  id String @id @default(uuid())
  name String @unique
  municipalities Municipality[]
  studentsBorn Student[] @relation("StudentBirthState")
  studentsResident Student[] @relation("StudentResidenceState")
}
model Municipality {
  id String @id @default(uuid())
  stateId String
  state FederalState @relation(fields:[stateId], references:[id], onDelete:Cascade)
  name String
  parishes Parish[]
  studentsBorn Student[] @relation("StudentBirthMunicipality")
  studentsResident Student[] @relation("StudentResidenceMunicipality")
  @@unique([stateId,name])
}
model Parish {
  id String @id @default(uuid())
  municipalityId String
  municipality Municipality @relation(fields:[municipalityId], references:[id], onDelete:Cascade)
  name String
  studentsBorn Student[] @relation("StudentBirthParish")
  studentsResident Student[] @relation("StudentResidenceParish")
  @@unique([municipalityId,name])
}

model AcademicYear {
  id String @id @default(uuid())
  name String @unique
  startDate DateTime
  endDate DateTime
  enrollmentCloseDate DateTime?
  academicClosedAt DateTime?
  academicClosedBy String?
  active Boolean @default(false)
  contributionAmount Decimal @db.Decimal(12,2)
  sections Section[]
  enrollments Enrollment[]
  lapses PedagogicalLapse[]
  contributions Contribution[]
  stableGroups StableGroup[]
  gradingPolicy GradingPolicy?
  createdAt DateTime @default(now())
}

model GradingPolicy {
  id String @id @default(uuid())
  academicYearId String @unique
  academicYear AcademicYear @relation(fields:[academicYearId], references:[id], onDelete:Cascade)
  passingScore Decimal @default(10) @db.Decimal(4,2)
  maxScore Decimal @default(20) @db.Decimal(4,2)
  pendingMaxSubjects Int @default(2)
  evaluationsMin Int @default(2)
  evaluationsMax Int @default(5)
  lapseCount Int @default(3)
  orientationAmin Decimal @default(18) @db.Decimal(4,2)
  orientationBmin Decimal @default(16) @db.Decimal(4,2)
  orientationCmin Decimal @default(12) @db.Decimal(4,2)
}

model Student {
  id String @id @default(uuid())
  active Boolean @default(true)
  nationality Nationality
  identityNumber String? @unique
  schoolIdentityNumber String? @unique
  firstName String
  middleName String?
  lastName String
  secondLastName String?
  sex Sex
  maritalStatus MaritalStatus?
  phone String?
  email String?
  birthPlace String
  birthStateId String?
  birthState FederalState? @relation("StudentBirthState", fields:[birthStateId], references:[id])
  birthMunicipalityId String?
  birthMunicipality Municipality? @relation("StudentBirthMunicipality", fields:[birthMunicipalityId], references:[id])
  birthParishId String?
  birthParish Parish? @relation("StudentBirthParish", fields:[birthParishId], references:[id])
  birthDate DateTime
  address String
  residenceStateId String?
  residenceState FederalState? @relation("StudentResidenceState", fields:[residenceStateId], references:[id])
  residenceMunicipalityId String?
  residenceMunicipality Municipality? @relation("StudentResidenceMunicipality", fields:[residenceMunicipalityId], references:[id])
  residenceParishId String?
  residenceParish Parish? @relation("StudentResidenceParish", fields:[residenceParishId], references:[id])
  motherName String?
  fatherName String?
  motherIdentity String?
  fatherIdentity String?
  motherAddress String?
  fatherAddress String?
  livingWith LivingWith
  bloodType String?
  disability Boolean @default(false)
  disabilityDetails String?
  medicalReport Boolean @default(false)
  allergy Boolean @default(false)
  allergyDetails String?
  originSchool String?
  destinationSchool String?
  observations String?
  enrollments Enrollment[]
  representatives StudentRepresentative[]
  emergencyContacts EmergencyContact[]
  anthropometrics AnthropometricRecord[]
  documents StudentDocument[]
  stableGroupMemberships StableGroupMembership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, lastName, firstName])
  @@index([identityNumber])
  @@index([schoolIdentityNumber])
}

model Representative {
  id String @id @default(uuid())
  active Boolean @default(true)
  nationality Nationality
  identityNumber String @unique
  firstName String
  middleName String?
  lastName String
  secondLastName String?
  profession String?
  address String
  birthPlace String?
  birthDate DateTime?
  sex Sex?
  email String?
  phone1 String
  phone2 String?
  workplace String?
  workAddress String?
  workPhone String?
  bankName String?
  accountType AccountType?
  accountNumber String?
  bloodType String?
  students StudentRepresentative[]
  contributions Contribution[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentRepresentative {
  studentId String
  representativeId String
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  representative Representative @relation(fields:[representativeId], references:[id], onDelete:Cascade)
  relationship RelationshipType
  isPrimary Boolean @default(false)
  livesWithStudent Boolean @default(false)
  authorizationDescription String?
  @@id([studentId, representativeId])
}

model EmergencyContact {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  firstName String
  middleName String?
  lastName String
  secondLastName String?
  identityNumber String?
  phone String
  address String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnthropometricRecord {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  enrollmentId String?
  enrollment Enrollment? @relation(fields:[enrollmentId], references:[id], onDelete:SetNull)
  measuredAt DateTime @default(now())
  heightCm Int
  weightGrams Int
  shirtSize String?
  pantSize String?
  shoeSize Int?
}

model StudentDocument {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  academicYearId String?
  type DocumentType
  presented Boolean @default(false)
  filePath String?
  originalName String?
  mimeType String?
  sizeBytes Int?
  notes String?
  uploadedAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([studentId, academicYearId, type])
}

model StudyPlan {
  id String @id @default(uuid())
  code String
  name String
  modality EducationModality
  specialtyName String?
  optionName String?
  hasMention Boolean @default(false)
  officialCatalog Boolean @default(false)
  sourceReference String?
  curriculumVerified Boolean @default(false)
  maxGrade Int
  titleName String
  active Boolean @default(true)
  effectiveFrom DateTime?
  effectiveTo DateTime?
  subjects StudyPlanSubject[]
  mentions Mention[]
  sections Section[]
  enrollments Enrollment[]
  @@unique([code, effectiveFrom])
}

model Subject {
  id String @id @default(uuid())
  code String @unique
  name String
  gradingType GradingType @default(NUMERIC)
  plans StudyPlanSubject[]
}

model StudyPlanSubject {
  id String @id @default(uuid())
  studyPlanId String
  studyPlan StudyPlan @relation(fields:[studyPlanId], references:[id], onDelete:Cascade)
  subjectId String
  subject Subject @relation(fields:[subjectId], references:[id])
  gradeLevel Int
  weeklyHours Int?
  annualHours Int?
  component String?
  sortOrder Int @default(0)
  active Boolean @default(true)
  teacherAssignments TeacherAssignment[]
  annualResults AnnualSubjectResult[]
  pendingSubjects PendingSubject[]
  enrollmentSubjects EnrollmentSubject[]
  @@unique([studyPlanId, subjectId, gradeLevel])
}

model Mention {
  id String @id @default(uuid())
  studyPlanId String
  studyPlan StudyPlan @relation(fields:[studyPlanId], references:[id], onDelete:Cascade)
  name String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sections Section[]
  @@unique([studyPlanId, name])
  @@index([studyPlanId, active])
}

model SectionName {
  id String @id @default(uuid())
  name String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id String @id @default(uuid())
  academicYearId String
  academicYear AcademicYear @relation(fields:[academicYearId], references:[id], onDelete:Cascade)
  studyPlanId String
  studyPlan StudyPlan @relation(fields:[studyPlanId], references:[id])
  mentionId String?
  mention Mention? @relation(fields:[mentionId], references:[id])
  mentionName String?
  gradeLevel Int
  name String
  shift String?
  capacity Int?
  rosterLockedAt DateTime?
  enrollments Enrollment[]
  teacherAssignments TeacherAssignment[]
  @@unique([academicYearId, studyPlanId, gradeLevel, name])
}

model Enrollment {
  id String @id @default(uuid())
  studentId String
  student Student @relation(fields:[studentId], references:[id])
  academicYearId String
  academicYear AcademicYear @relation(fields:[academicYearId], references:[id])
  studyPlanId String
  studyPlan StudyPlan @relation(fields:[studyPlanId], references:[id])
  sectionId String
  section Section @relation(fields:[sectionId], references:[id])
  gradeLevel Int
  registrationDate DateTime @default(now())
  lastApprovedYear String?
  literal String?
  listNumber Int?
  condition StudentCondition @default(REGULAR)
  academicCondition StudentCondition?
  isLateEnrollment Boolean @default(false)
  notes String?
  previousEnrollmentId String? @unique
  previousEnrollment Enrollment? @relation("EnrollmentProgression", fields:[previousEnrollmentId], references:[id], onDelete:SetNull)
  nextEnrollment Enrollment? @relation("EnrollmentProgression")
  academicOutcomeFinalizedAt DateTime?
  anthropometrics AnthropometricRecord[]
  withdrawal Withdrawal?
  movements EnrollmentMovement[]
  attempts AssessmentAttempt[]
  lapseGrades LapseGrade[]
  annualResults AnnualSubjectResult[]
  pendingSubjects PendingSubject[]
  curriculumSubjects EnrollmentSubject[] @relation("EnrollmentCurriculum")
  sourceCurriculumSubjects EnrollmentSubject[] @relation("EnrollmentCurriculumSource")
  stableGroups StableGroupMembership[]
  @@unique([studentId, academicYearId])
  @@unique([sectionId, listNumber])
  @@index([academicYearId, gradeLevel, condition])
}

model EnrollmentSubject {
  id String @id @default(uuid())
  enrollmentId String
  enrollment Enrollment @relation("EnrollmentCurriculum", fields:[enrollmentId], references:[id], onDelete:Cascade)
  studyPlanSubjectId String
  studyPlanSubject StudyPlanSubject @relation(fields:[studyPlanSubjectId], references:[id])
  origin EnrollmentSubjectOrigin @default(PLAN_ACTUAL)
  sourceEnrollmentId String?
  sourceEnrollment Enrollment? @relation("EnrollmentCurriculumSource", fields:[sourceEnrollmentId], references:[id], onDelete:SetNull)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([enrollmentId, studyPlanSubjectId])
  @@index([enrollmentId, origin, active])
}

model Withdrawal {
  id String @id @default(uuid())
  enrollmentId String @unique
  enrollment Enrollment @relation(fields:[enrollmentId], references:[id], onDelete:Cascade)
  withdrawalDate DateTime
  destinationInstitution String?
  reason String
  type WithdrawalType
  createdAt DateTime @default(now())
}

model EnrollmentMovement {
  id String @id @default(uuid())
  enrollmentId String
  enrollment Enrollment @relation(fields:[enrollmentId], references:[id], onDelete:Cascade)
  type EnrollmentMovementType
  movementDate DateTime
  withdrawalType WithdrawalType?
  destinationInstitution String?
  reason String?
  conditionBefore StudentCondition?
  conditionAfter StudentCondition?
  createdAt DateTime @default(now())
  @@index([enrollmentId, movementDate])
  @@index([type, movementDate])
}

model Contribution {
  id String @id @default(uuid())
  representativeId String
  representative Representative @relation(fields:[representativeId], references:[id])
  academicYearId String
  academicYear AcademicYear @relation(fields:[academicYearId], references:[id])
  amount Decimal @db.Decimal(12,2)
  paidAt DateTime @default(now())
  reference String?
  notes String?
  @@unique([representativeId, academicYearId])
}


model StaffPositionCatalog {
  id String @id @default(uuid())
  staffType StaffType
  code String
  description String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([staffType, code])
  @@index([staffType, active])
}

model Staff {
  id String @id @default(uuid())
  staffType StaffType @default(DOCENTE)
  nationality Nationality @default(VENEZOLANO)
  identityNumber String @unique
  maritalStatus String?
  firstName String
  middleName String?
  lastName String
  secondLastName String?
  address String
  phone String?
  email String?
  sex Sex?
  birthPlace String?
  birthDate DateTime?
  bloodType String?
  housingTenure HousingTenure?
  housingRepairNeeded Boolean @default(false)
  housingRepairDescription String?
  hasDisease Boolean @default(false)
  diseaseDescription String?
  needsSurgery Boolean @default(false)
  surgeryDescription String?
  wearsGlasses Boolean @default(false)
  eyeConditionDescription String?
  disability Boolean @default(false)
  medicalReport Boolean @default(false)
  childrenCount Int @default(0)
  cargoCode String?
  cargoDescription String?
  institutionalFunction String?
  pantSize String?
  shirtSize String?
  shoeSize Int?
  bankName String?
  accountType AccountType?
  accountNumber String?
  ministryEntryDate DateTime?
  employmentCondition EmploymentCondition @default(ACTIVO)
  continuousLeaveDisease String?
  continuousLeaveCount Int?
  incapacityExecutor IncapacityExecutor?
  incapacityDate DateTime?
  retirementDate DateTime?
  retirementProcessDate DateTime?
  retirementProcessObservation String?
  administrativeProcessDate DateTime?
  administrativeProcessObservation String?
  active Boolean @default(true)
  qualifications StaffQualification[]
  children StaffChild[]
  assignments TeacherAssignment[]
  user User?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffChild {
  id String @id @default(uuid())
  staffId String
  staff Staff @relation(fields:[staffId], references:[id], onDelete:Cascade)
  firstName String
  middleName String?
  lastName String
  secondLastName String?
  identityNumber String?
  birthDate DateTime
  studying Boolean @default(false)
  educationLevel String?
  institutionName String?
  hasDisease Boolean @default(false)
  diseaseDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([staffId, birthDate])
  @@index([identityNumber])
}

model StaffQualification {
  id String @id @default(uuid())
  staffId String
  staff Staff @relation(fields:[staffId], references:[id], onDelete:Cascade)
  type QualificationType
  title String
  institution String?
  year Int?
}

model PedagogicalLapse {
  id String @id @default(uuid())
  academicYearId String
  academicYear AcademicYear @relation(fields:[academicYearId], references:[id], onDelete:Cascade)
  number Int
  startDate DateTime
  endDate DateTime
  status LapseStatus @default(PLANNED)
  assessments Assessment[]
  lapseGrades LapseGrade[]
  @@unique([academicYearId, number])
}

model TeacherAssignment {
  id String @id @default(uuid())
  active Boolean @default(true)
  assignedAt DateTime @default(now())
  staffId String
  staff Staff @relation(fields:[staffId], references:[id])
  sectionId String
  section Section @relation(fields:[sectionId], references:[id], onDelete:Cascade)
  studyPlanSubjectId String
  studyPlanSubject StudyPlanSubject @relation(fields:[studyPlanSubjectId], references:[id])
  assessments Assessment[]
  lapseGrades LapseGrade[]
  @@unique([staffId, sectionId, studyPlanSubjectId])
}

model Assessment {
  id String @id @default(uuid())
  teacherAssignmentId String
  teacherAssignment TeacherAssignment @relation(fields:[teacherAssignmentId], references:[id], onDelete:Cascade)
  lapseId String
  lapse PedagogicalLapse @relation(fields:[lapseId], references:[id])
  title String
  orderNumber Int
  weight Decimal @default(1) @db.Decimal(8,4)
  technique String?
  instrument String?
  scheduledAt DateTime?
  attempts AssessmentAttempt[]
  @@unique([teacherAssignmentId, lapseId, orderNumber])
}

model AssessmentAttempt {
  id String @id @default(uuid())
  assessmentId String
  assessment Assessment @relation(fields:[assessmentId], references:[id], onDelete:Cascade)
  enrollmentId String
  enrollment Enrollment @relation(fields:[enrollmentId], references:[id], onDelete:Cascade)
  form AssessmentForm
  status AttemptStatus @default(PENDIENTE)
  attendance AttendanceStatus @default(PRESENTE)
  score Decimal? @db.Decimal(4,2)
  technique String?
  instrument String?
  appliedAt DateTime?
  notes String?
  @@unique([assessmentId, enrollmentId, form])
}

model LapseGrade {
  id String @id @default(uuid())
  enrollmentId String
  enrollment Enrollment @relation(fields:[enrollmentId], references:[id], onDelete:Cascade)
  teacherAssignmentId String
  teacherAssignment TeacherAssignment @relation(fields:[teacherAssignmentId], references:[id], onDelete:Cascade)
  lapseId String
  lapse PedagogicalLapse @relation(fields:[lapseId], references:[id], onDelete:Cascade)
  score Decimal? @db.Decimal(4,2)
  closedAt DateTime?
  @@unique([enrollmentId, teacherAssignmentId, lapseId])
}

model AnnualSubjectResult {
  id String @id @default(uuid())
  enrollmentId String
  enrollment Enrollment @relation(fields:[enrollmentId], references:[id], onDelete:Cascade)
  studyPlanSubjectId String
  studyPlanSubject StudyPlanSubject @relation(fields:[studyPlanSubjectId], references:[id])
  numericScore Decimal? @db.Decimal(4,2)
  letterScore String?
  status ResultStatus
  finalizedAt DateTime @default(now())
  @@unique([enrollmentId, studyPlanSubjectId])
}

model PendingSubject {
  id String @id @default(uuid())
  enrollmentId String
  enrollment Enrollment @relation(fields:[enrollmentId], references:[id], onDelete:Cascade)
  studyPlanSubjectId String?
  studyPlanSubject StudyPlanSubject? @relation(fields:[studyPlanSubjectId], references:[id])
  // Para materias pendientes que provienen de 6° grado u otro currículo externo
  // y no existen dentro del plan 31059/41049 de educación media.
  manualSubjectName String?
  sourceLevel String?
  sourceAcademicYear String
  status PendingStatus @default(ABIERTA)
  opportunities PendingOpportunity[]
  reviewAttempts ReviewAttempt[]
  @@unique([enrollmentId, studyPlanSubjectId, sourceAcademicYear])
  @@index([enrollmentId, manualSubjectName])
}

model PendingOpportunity {
  id String @id @default(uuid())
  pendingSubjectId String
  pendingSubject PendingSubject @relation(fields:[pendingSubjectId], references:[id], onDelete:Cascade)
  sequence Int
  label String
  scheduledDate DateTime?
  attempts PendingAttempt[]
  @@unique([pendingSubjectId, sequence])
}

model PendingAttempt {
  id String @id @default(uuid())
  opportunityId String
  opportunity PendingOpportunity @relation(fields:[opportunityId], references:[id], onDelete:Cascade)
  form AssessmentForm
  status AttemptStatus @default(PENDIENTE)
  attendance AttendanceStatus @default(PRESENTE)
  score Decimal? @db.Decimal(4,2)
  technique String?
  instrument String?
  appliedAt DateTime?
  @@unique([opportunityId, form])
}

model ReviewAttempt {
  id String @id @default(uuid())
  pendingSubjectId String
  pendingSubject PendingSubject @relation(fields:[pendingSubjectId], references:[id], onDelete:Cascade)
  form AssessmentForm
  status AttemptStatus @default(PENDIENTE)
  attendance AttendanceStatus @default(PRESENTE)
  score Decimal? @db.Decimal(4,2)
  technique String?
  instrument String?
  appliedAt DateTime?
  @@unique([pendingSubjectId, form])
}

model StableGroup {
  id String @id @default(uuid())
  academicYearId String
  academicYear AcademicYear @relation(fields:[academicYearId], references:[id], onDelete:Cascade)
  name String
  teacherId String?
  description String?
  memberships StableGroupMembership[]
  @@unique([academicYearId,name])
}

model StableGroupMembership {
  id String @id @default(uuid())
  stableGroupId String
  stableGroup StableGroup @relation(fields:[stableGroupId], references:[id], onDelete:Cascade)
  studentId String
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  enrollmentId String
  enrollment Enrollment @relation(fields:[enrollmentId], references:[id], onDelete:Cascade)
  joinedAt DateTime @default(now())
  @@unique([stableGroupId, studentId])
}
